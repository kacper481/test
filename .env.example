# Shared infra
OPENSEARCH_HOST=http://opensearch:9200
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
AMQP_URL=amqp://guest:guest@rabbitmq:5672/
LOG_LEVEL=INFO

# RabbitMQ credentials (compose uses these to set broker defaults).
# Change these for any non-local deployment.
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# Gateway only
ITEMS_SVC_URL=http://items-svc:8001
USERS_SVC_URL=http://users-svc:8002

# Load generator only
GATEWAY_URL=http://gateway:8000
RPS=3
SCENARIO=steady   # steady | read_heavy | write_heavy | spike

# ---------------------------------------------------------------------------
# Production toggles (opt-in; off by default for the learning experience)
# ---------------------------------------------------------------------------
# Require X-API-Key on every /api/* request. Unset = open access.
# GATEWAY_API_KEY=replace-me-with-a-real-secret

# Per-IP rate limit (requests/minute). Unset or 0 = unlimited.
# RATE_LIMIT_PER_MINUTE=60

# Loadgen sends this header if set (must match GATEWAY_API_KEY).
# LOADGEN_API_KEY=replace-me-with-a-real-secret

# ---------------------------------------------------------------------------
# Chaos / exercise toggles (all opt-in; unset by default)
# Each toggle writes its source onto the affected span so it's visible in Jaeger.
# ---------------------------------------------------------------------------
# Adds N ms latency to items search (Exercise 3, 7)
# CHAOS_ITEMS_SEARCH_MS=300

# Fraction (0..1) of users.get requests that return 500 (Exercise 4)
# CHAOS_USERS_GET_ERROR_RATE=0.3

# Adds N ms latency to gateway's owner-validation hop (Exercise 7)
# CHAOS_GATEWAY_VALIDATE_MS=80

# Adds N ms latency to every OpenSearch index operation
# CHAOS_OS_INDEX_SLOW_MS=150
